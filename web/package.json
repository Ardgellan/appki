{
  "name": "appki-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "format": "prettier --write src test index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src test index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
