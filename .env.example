# Заполните локальную .env. Файл не попадёт в Git.
APPKI_BRAND=Аппки
PUBLIC_BASE_URL=https://85.239.144.214

# BotFather → /newbot. Username — без @.
BOT_TOKEN=
BOT_USERNAME=
SUPPORT_URL=

# ЮKassa: данные именно ТЕСТОВОГО магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MODE=test
# 1 рубль в тестовом режиме — реального списания нет.
HAPP_PRICE_RUB=1.00

# Активация пока через поддержку. Личный Apple Account сюда не добавляйте.
ACTIVATION_MODE=manual
ACTIVATION_APPLE_ID=
ACTIVATION_PASSWORD=
ACTIVATION_INSTRUCTIONS="После установки откройте Happ. Если приложение сразу закрывается, обратитесь в поддержку по номеру заказа. Для активации может потребоваться вход в раздел App Store / Медиаматериалы и покупки. Основной iCloud менять не нужно."

# Серверные пути. Скрипт развёртывания использует их на VPS.
DATABASE_PATH=/var/lib/appki/appki.sqlite3
STATIC_DIR=/opt/appki/current/web/dist
HAPP_IPA_PATH=/var/lib/appki/apps/Happ.ipa
HAPP_IPA_SHA256=94e9591fe92be4589c19344ab7089d0b6abe101cf9cfa7a80707d6c390a4a2f2
AUTH_MAX_AGE_SECONDS=3600
SESSION_TTL_SECONDS=86400
INSTALL_TTL_SECONDS=3600
