[Unit]
Description=Appki API and Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appki
Group=appki
WorkingDirectory=/opt/appki/current
EnvironmentFile=/etc/appki/appki.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/appki/venv/bin/python -m uvicorn appki.main:create_app --factory --host 127.0.0.1 --port 18880 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/appki
ReadOnlyPaths=/var/lib/appki/artifacts
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
