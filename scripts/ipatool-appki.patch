+package appstore
+
+import (
+	"net/url"
+	"testing"
+)
+
+func TestPrivateAccountBinding(t *testing.T) {
+	t.Setenv("APPKI_EXPECTED_ACCOUNT_SHA256", PrivateAccountIdentity("owner@example.invalid"))
+	if err := validatePrivateAccount(" OWNER@example.invalid "); err != nil {
+		t.Fatal(err)
+	}
+	if err := validatePrivateAccount("other@example.invalid"); err == nil {
+		t.Fatal("different account accepted")
+	}
+}
+
+func TestPrivateAuthEndpointNormalization(t *testing.T) {
+	path := PrivateAppStoreAPIPathAuth
+	for _, endpoint := range []string{
+		"https://buy.itunes.apple.com" + path,
+		"https://buy.itunes.apple.com" + path + "/",
+		"https://p7-buy.itunes.apple.com:443" + path + "?Pod=7&routing=a%2Fb+c",
+	} {
+		expected, _ := url.Parse(endpoint)
+		normalized, err := normalizePrivateAuthEndpoint(endpoint)
+		if err != nil {
+			t.Fatal(err)
+		}
+		parsed, _ := url.Parse(normalized)
+		if parsed.Path != path+"/" || parsed.Host != expected.Host || parsed.RawQuery != expected.RawQuery || parsed.Scheme != "https" {
+			t.Fatal("routing changed")
+		}
+	}
+	for _, endpoint := range []string{
+		"http://buy.itunes.apple.com" + path,
+		"https://example.com" + path,
+		"https://buy.itunes.apple.com.evil.example" + path,
+		"https://user@buy.itunes.apple.com" + path,
+		"https://buy.itunes.apple.com:8443" + path,
+		"https://buy.itunes.apple.com" + path + "//",
+		"https://buy.itunes.apple.com" + path + "%2f",
+		"https://buy.itunes.apple.com" + path + "/extra",
+		"https://buy.itunes.apple.com" + path + "#fragment",
+	} {
+		if _, err := normalizePrivateAuthEndpoint(endpoint); err == nil {
+			t.Fatal("invalid authentication URL accepted")
+		}
+	}
+}
