@@ -0,0 +1,162 @@
+package cmd
+
+import (
+	"context"
+	"crypto/x509"
+	"errors"
+	"github.com/majd/ipatool/v2/pkg/appstore"
+	appkihttp "github.com/majd/ipatool/v2/pkg/http"
+	"github.com/spf13/cobra"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func preparePrivateAdapter(cmd *cobra.Command) error {
+	if keychainPassphrase != "" {
+		return errors.New("secret_argument_disabled")
+	}
+	for _, name := range []string{"email", "password", "auth-code", "verbose", "purchase"} {
+		if flag := cmd.Flag(name); flag != nil && flag.Changed {
+			return errors.New("unsafe_argument_disabled")
+		}
+	}
+	if !filepath.IsAbs(keychainPassphraseFile) {
+		return errors.New("private_passphrase_required")
+	}
+	info, err := os.Lstat(keychainPassphraseFile)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
+		return errors.New("private_passphrase_unavailable")
+	}
+	if info.Size() < 32 || info.Size() > 4096 {
+		return errors.New("private_passphrase_unavailable")
+	}
+	bytes, err := os.ReadFile(keychainPassphraseFile)
+	if err != nil {
+		return errors.New("private_passphrase_unavailable")
+	}
+	keychainPassphrase = strings.TrimSpace(string(bytes))
+	if len(keychainPassphrase) < 32 {
+		return errors.New("private_passphrase_unavailable")
+	}
+	return nil
+}
+
+type privateDiagnosticResult struct {
+	Code       string
+	Stage      string
+	HTTPStatus int
+}
+
+// Only bounded enums/status leave the process. Never return error text, URLs,
+// account data, Apple response bodies, correlation IDs or arbitrary metadata.
+func privateDiagnostic(err error) privateDiagnosticResult {
+	text := strings.ToLower(err.Error())
+	diagnostic := privateDiagnosticResult{Code: "acquisition_failed", Stage: "unknown"}
+	for _, pair := range [][2]string{
+		{"failed to get mac address", "machine"}, {"failed to get bag", "bag"},
+		{"apple sap assets", "assets"}, {"load sap assets", "assets"},
+		{"unicorn", "runtime"}, {"guest", "runtime"},
+		{"failed to initialize sap action signer", "signer_setup"},
+		{"2fa verification", "verification"}, {"sign-in request", "authentication"},
+		{"authentication", "authentication"}, {"failed to close sap", "signer_close"},
+		{"account_identity_mismatch", "account_binding"}, {"passphrase", "local_storage"},
+		{"failed to get account", "local_storage"}, {"failed to save account", "local_storage"},
+	} {
+		if strings.Contains(text, pair[0]) {
+			diagnostic.Stage = pair[1]
+			break
+		}
+	}
+	var response *appkihttp.UnexpectedResponseError
+	if errors.As(err, &response) && response.StatusCode >= 100 && response.StatusCode <= 599 {
+		diagnostic.HTTPStatus = response.StatusCode
+	}
+	if errors.Is(err, appstore.ErrAuthCodeRequired) {
+		diagnostic.Code, diagnostic.Stage = "requires_2fa", "verification"
+		return diagnostic
+	}
+	var privateResponse *appstore.PrivateAuthenticationResponseError
+	if errors.As(err, &privateResponse) {
+		diagnostic.Stage = "authentication"
+		switch privateResponse.Code {
+		case "account_disabled", "authentication_rejected", "upstream_response_invalid":
+			diagnostic.Code = privateResponse.Code
+		}
+		if privateResponse.HTTPStatus >= 100 && privateResponse.HTTPStatus <= 599 {
+			diagnostic.HTTPStatus = privateResponse.HTTPStatus
+		}
+		return diagnostic
+	}
+	if strings.Contains(text, "account_identity_mismatch") {
+		diagnostic.Code = "account_identity_mismatch"
+		return diagnostic
+	}
+	var dns *net.DNSError
+	var timeout net.Error
+	var operation *net.OpError
+	var unknownCA x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var certificate x509.CertificateInvalidError
+	if errors.As(err, &dns) {
+		diagnostic.Code = "dns_failed"
+		return diagnostic
+	}
+	if errors.Is(err, context.DeadlineExceeded) || (errors.As(err, &timeout) && timeout.Timeout()) {
+		diagnostic.Code = "network_timeout"
+		return diagnostic
+	}
+	if errors.As(err, &unknownCA) || errors.As(err, &hostname) || errors.As(err, &certificate) {
+		diagnostic.Code = "tls_failed"
+		return diagnostic
+	}
+	if errors.As(err, &operation) {
+		diagnostic.Code = "network_failed"
+		return diagnostic
+	}
+	if diagnostic.HTTPStatus == 429 {
+		diagnostic.Code = "rate_limited"
+		return diagnostic
+	}
+	if errors.As(err, &response) {
+		diagnostic.Code = "upstream_response_invalid"
+		if diagnostic.HTTPStatus >= 300 {
+			diagnostic.Code = "upstream_http_error"
+		}
+		return diagnostic
+	}
+	if strings.Contains(text, "account is disabled") {
+		diagnostic.Code = "account_disabled"
+		return diagnostic
+	}
+	if strings.Contains(text, "password is incorrect") || strings.Contains(text, "invalid credentials") {
+		diagnostic.Code, diagnostic.Stage = "credentials_rejected", "authentication"
+		return diagnostic
+	}
+	if strings.Contains(text, "license") {
+		diagnostic.Code = "license_required"
+		return diagnostic
+	}
+	if strings.Contains(text, "failed to get account") || strings.Contains(text, "password token") {
+		diagnostic.Code = "requires_auth"
+		return diagnostic
+	}
+	if strings.Contains(text, "no usable authentication response") {
+		diagnostic.Code, diagnostic.Stage = "upstream_response_invalid", "authentication"
+		return diagnostic
+	}
+	switch diagnostic.Stage {
+	case "machine":
+		diagnostic.Code = "machine_identity_failed"
+	case "assets", "runtime", "signer_setup", "signer_close":
+		diagnostic.Code = "runtime_setup_failed"
+	case "local_storage":
+		diagnostic.Code = "private_storage_failed"
+	case "authentication", "verification":
+		diagnostic.Code = "authentication_failed"
+	case "bag":
+		diagnostic.Code = "upstream_response_invalid"
+	}
+	return diagnostic
+}
