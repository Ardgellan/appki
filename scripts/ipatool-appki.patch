+package cmd
+
+import (
+	"github.com/spf13/cobra"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPrivatePassphraseFile(t *testing.T) {
+	keychainPassphrase = ""
+	keychainPassphraseFile = filepath.Join(t.TempDir(), "passphrase")
+	if err := os.WriteFile(keychainPassphraseFile, []byte("abcdefghijklmnopqrstuvwxyz0123456789"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := preparePrivateAdapter(&cobra.Command{}); err != nil {
+		t.Fatal(err)
+	}
+	if keychainPassphrase != "abcdefghijklmnopqrstuvwxyz0123456789" {
+		t.Fatal("file input failed")
+	}
+	keychainPassphrase = ""
+	if err := os.Chmod(keychainPassphraseFile, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := preparePrivateAdapter(&cobra.Command{}); err == nil {
+		t.Fatal("public file accepted")
+	}
+	keychainPassphrase = ""
+}
