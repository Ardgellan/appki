+func TestPrivatePassphraseFile(t *testing.T) {
+	keychainPassphrase = ""
+	keychainPassphraseFile = filepath.Join(t.TempDir(), "passphrase")
+	if err := os.WriteFile(keychainPassphraseFile, []byte("abcdefghijklmnopqrstuvwxyz0123456789"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := preparePrivateAdapter(&cobra.Command{}); err != nil {
+		t.Fatal(err)
+	}
+	if keychainPassphrase != "abcdefghijklmnopqrstuvwxyz0123456789" {
+		t.Fatal("file input failed")
+	}
+	keychainPassphrase = ""
+	if err := os.Chmod(keychainPassphraseFile, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := preparePrivateAdapter(&cobra.Command{}); err == nil {
+		t.Fatal("public file accepted")
+	}
+	keychainPassphrase = ""
+}
+
+func TestPrivateSafeDiagnostic(t *testing.T) {
+	cases := []struct {
+		err         error
+		code, stage string
+		status      int
+	}{
+		{fmt.Errorf("sign-in request failed: %w", &appkihttp.UnexpectedResponseError{StatusCode: 301, Snippet: "PASSWORD TOKEN ACCOUNT"}), "upstream_http_error", "authentication", 301},
+		{fmt.Errorf("failed to get bag: %w", &appkihttp.UnexpectedResponseError{StatusCode: 403, CorrelationID: "SECRET"}), "upstream_http_error", "bag", 403},
+		{fmt.Errorf("sign-in request failed: %w", &appkihttp.UnexpectedResponseError{StatusCode: 429}), "rate_limited", "authentication", 429},
+		{fmt.Errorf("sign-in request failed: %w", context.DeadlineExceeded), "network_timeout", "authentication", 0},
+		{fmt.Errorf("failed to get bag: %w", &net.DNSError{Name: "SECRET", Err: "fixture"}), "dns_failed", "bag", 0},
+		{fmt.Errorf("failed to initialize SAP action signer: load Unicorn SECRET"), "runtime_setup_failed", "runtime", 0},
+		{appstore.ErrAuthCodeRequired, "requires_2fa", "verification", 0},
+		{&appstore.PrivateAuthenticationResponseError{Code: "upstream_response_invalid", HTTPStatus: 200}, "upstream_response_invalid", "authentication", 200},
+		{&appstore.PrivateAuthenticationResponseError{Code: "authentication_rejected", HTTPStatus: 200}, "authentication_rejected", "authentication", 200},
+		{&appstore.PrivateAuthenticationResponseError{Code: "PASSWORD", HTTPStatus: 700}, "acquisition_failed", "authentication", 0},
+		{errors.New("PASSWORD HTTP 401 SECRET"), "acquisition_failed", "unknown", 0},
+	}
+	for _, item := range cases {
+		diagnostic := privateDiagnostic(item.err)
+		if diagnostic.Code != item.code || diagnostic.Stage != item.stage || diagnostic.HTTPStatus != item.status {
+			t.Fatalf("unexpected normalized diagnostic: %+v", diagnostic)
+		}
+		if strings.Contains(fmt.Sprint(diagnostic), "SECRET") || strings.Contains(fmt.Sprint(diagnostic), "PASSWORD") {
+			t.Fatal("raw diagnostic escaped")
+		}
+	}
+}
+
+func TestPrivateAuthenticationNeverAutomaticallyFollowsRedirect(t *testing.T) {
+	followed := false
+	destination := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { followed = true; w.WriteHeader(200) }))
+	defer destination.Close()
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Location", destination.URL)
+		w.WriteHeader(302)
+	}))
+	defer origin.Close()
+	client := appkihttp.NewClient[interface{}](appkihttp.Args{Authentication: true})
+	for _, suffix := range []string{"", "/"} {
+		req, err := http.NewRequest("POST", origin.URL+"/WebObjects/MZFinance.woa/wa/authenticate"+suffix, strings.NewReader("public fixture"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		res, err := client.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		res.Body.Close()
+		if res.StatusCode != 302 || followed {
+			t.Fatal("signed authentication redirect was followed")
+		}
+	}
+}
