+package appstore
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net/url"
+	"os"
+	"strings"
+)
+
+func PrivateAccountIdentity(email string) string {
+	digest := sha256.Sum256([]byte(strings.ToLower(strings.TrimSpace(email))))
+	return hex.EncodeToString(digest[:])
+}
+
+func validatePrivateAccount(email string) error {
+	expected := os.Getenv("APPKI_EXPECTED_ACCOUNT_SHA256")
+	if expected != "" && PrivateAccountIdentity(email) != expected {
+		return errors.New("account_identity_mismatch")
+	}
+	return nil
+}
+
+// Narrow backport of upstream f9aa653/1ec8b3e: validate before normalizing;
+// retain the official bag/pod HTTPS host and routing query exactly.
+func normalizePrivateAuthEndpoint(endpoint string) (string, error) {
+	parsed, err := url.Parse(endpoint)
+	if err != nil || parsed.Scheme != "https" || parsed.Host == "" || parsed.User != nil ||
+		parsed.Fragment != "" || parsed.RawPath != "" || (parsed.Port() != "" && parsed.Port() != "443") {
+		return "", errors.New("invalid authentication endpoint")
+	}
+	host := strings.ToLower(parsed.Hostname())
+	if host != PrivateAppStoreAPIDomain && !strings.HasSuffix(host, "-buy.itunes.apple.com") {
+		return "", errors.New("unsupported authentication endpoint")
+	}
+	if parsed.Path != PrivateAppStoreAPIPathAuth && parsed.Path != PrivateAppStoreAPIPathAuth+"/" {
+		return "", errors.New("unsupported authentication endpoint")
+	}
+	parsed.Path = PrivateAppStoreAPIPathAuth + "/"
+	return parsed.String(), nil
+}
+
+// Carries only a static code and numeric HTTP status. Apple messages, bodies,
+// credentials and arbitrary response metadata never enter this error.
+type PrivateAuthenticationResponseError struct {
+	Code       string
+	HTTPStatus int
+}
+
+func (*PrivateAuthenticationResponseError) Error() string {
+	return "private authentication response failed"
+}
